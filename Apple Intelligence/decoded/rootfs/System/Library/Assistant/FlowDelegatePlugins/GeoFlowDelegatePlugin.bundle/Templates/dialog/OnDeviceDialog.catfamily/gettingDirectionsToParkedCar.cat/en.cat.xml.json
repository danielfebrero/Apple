"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?>\n<cat id=\"OnDeviceDialog#gettingDirectionsToParkedCar\" locale=\"en\" xmlns=\"urn:apple:names:siri:cat:1.0\">\n\t<all>\n\t\t<dialog>Getting <opt><phrase name=\"transportationModePhrase\"/> </opt>directions to your parked car…<opt> <phrase name=\"remindParkingNote\"/></opt></dialog>\n\t</all>\n\t<phrases>\n\t\t<switch phrase=\"transportationModePhrase\" value=\"transportationMode\">\n\t\t\t<text case=\"'driving'\">driving</text>\n\t\t\t<text case=\"'cycling'\">cycling</text>\n\t\t\t<text case=\"'transit'\">transit</text>\n\t\t\t<text case=\"'walking'\">walking</text>\n\t\t\t<text/>\n\t\t</switch>\n\t\t<random phrase=\"remindParkingNote\">\n\t\t\t<text>You also asked me to remember, '<var name=\"parkingNote\"/>'.</text>\n\t\t</random>\n\t</phrases>\n</cat>\n"
