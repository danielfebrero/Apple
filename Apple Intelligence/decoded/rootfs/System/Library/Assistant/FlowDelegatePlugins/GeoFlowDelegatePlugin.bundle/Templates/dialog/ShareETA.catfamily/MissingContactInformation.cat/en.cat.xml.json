"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?>\n<cat id=\"ShareETA#MissingContactInformation\" xmlns=\"urn:apple:names:siri:cat:1.0\" locale=\"en\" >\n  \n  <conditions>\n      <condition name=\"firstThreeTimes\"><expression name=\"dialogState.usageCount\" op=\"le\" value=\"3\"/></condition>\n  </conditions>\n\n  <all>\n      <dialog>Sorry, I don't have enough contact info to share your ETA<opt> with <var name=\"recipient.conversationalName\"/></opt>.</dialog>\n      <dialog id=\"firstThreeResponse\" condition=\"firstThreeTimes\"> You can add it in Contacts, when it's safe to do so.</dialog>\n  </all>\n</cat>\n\n"
