"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?>\n<cat xmlns=\"urn:apple:names:siri:cat:1.0\" id=\"UserSession#ActiveSessionUserNotRecognized\" locale=\"en\">\n  <conditions>\n    <condition name=\"isFirstTwoTimes\">\n      <expression name=\"dialogState.usageCount\" op=\"le\" value=\"2\"/>\n    </condition>\n  </conditions>\n  <all>\n    <first>\n      <dialog condition=\"activeSessionUser\" spokenOnly=\"false\">Sorry, <var name=\"activeSessionUser\"/> is currently using this <var name=\"deviceName\"/>.</dialog>\n      <dialog spokenOnly=\"false\">Sorry, someone is currently using this <var name=\"deviceName\"/>.</dialog>\n    </first>\n    <dialog condition=\"isFirstTwoTimes\" spokenOnly=\"false\">Please try again later.</dialog>\n  </all>\n</cat>\n"
