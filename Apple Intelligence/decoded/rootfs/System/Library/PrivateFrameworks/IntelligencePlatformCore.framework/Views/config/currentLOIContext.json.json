{
  "artifact": {
    "contextualEvents": {
      "entityType": "LOIVisit",
      "tableName": "loiContextEvents"
    },
    "path": "internal/views.db",
    "type": "contextualEvents"
  },
  "customViewClass": "ContextualEventsView",
  "featureFlag": "EntityRelevanceBiomeSources",
  "name": "currentLOIContext",
