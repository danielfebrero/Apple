  "update": {
    "biomeListeners": [
      {
        "computeIfPastSLA": false,
        "schedule": "every21Minutes",
        "stream": "Location.Semantic"
      }
    ],
    "viewListeners": [
      {
        "name": "handleMap",
        "requiredSource": true,
        "schedule": "none"
      },
      {
        "name": "phPersonIdentifierMap",
        "requiredSource": true,
        "schedule": "none"
      }
    ]
  }
}
