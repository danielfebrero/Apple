{
  "candidateGeneratorConfig": {
    "algorithms": [
      {
        "textMatchingSearch": {
          "pattern": "prefix"
        }
      }
    ],
    "populateFeatures": false,
    "searchMode": {
      "topK": {
        "numLimits": 100
      }
    },
    "useRelevanceFeatures": true
  },
  "enableCache": false,
  "mentionGenPreprocessorConfig": {
    "mode": [
      "morphun"
    ]
  },
  "mentionGeneratorConfig": {
    "algorithm": "fullContextMention"
  },
  "preprocessorConfig": {
    "maxNumberOfSourceIDs": 100,
    "maxNumberOfTokens": 64,
    "maxQuerySize": 1024,
    "mode": [
      "morphun"
    ]
  },
  "rerankerConfig": {
    "algorithm": "mentionSimilarity"
  }
}
