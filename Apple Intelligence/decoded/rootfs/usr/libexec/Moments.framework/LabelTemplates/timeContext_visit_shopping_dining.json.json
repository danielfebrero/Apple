"{\n    \"cases\": [\n        {\n            \"bundleType\":\"timeContext\",\n            \"templates\" :[\n\n                {\n                    \"_comment_\": \"/* 2 actions: visit + dining/shopping (back to back) with same place (example: visit to place A + shopping, another visit to place A, the second visit has lots of photos so goodness score is higher)*/\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_1=visit\", \"action_type_2!=visit\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=1\"],\n                    \"labels\":[\"{action_2} and more, {place}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions: visit + dining/shopping (back to back) with same place(example: visit to place A + shopping, another visit to place A, the first visit has lots of photos so goodness score is higher) */\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_1!=visit\", \"action_type_2=visit\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=1\"],\n                    \"labels\":[\"{action_1} and more, {place}|TitleCap\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 2 actions: visit + shopping (back to back) and visit with place 1 of medium confidence, shopping with place 2 of medium/low confidence (example: visit to place A + shopping, another visit to place B, the second visit has lots of photos so goodness score is higher)*/\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_1=visit\", \"action_type_2=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\", \"place_count=2\",\"confidence_1=medium\", \"confidence_2!=high\"],\n                    \"labels\":[\"Visit near {place_1} and {action_2}\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions: visit + shopping (back to back) and visit with place 1 of medium confidence, shopping with place 2 of high confidence (example: visit to place A + shopping, another visit to place B, the second visit has lots of photos so goodness score is higher) */\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_1=visit\", \"action_type_2=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\",\"confidence_1=medium\", \"confidence_2=high\"],\n                    \"labels\":[\"Visit near {place_1} and shopping at {place_2}\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions: visit + shopping (back to back) and visit with place 1 of high/low confidence, shopping with place 2 of medium/low confidence * (example: visit to place A + shopping, another visit to place B, the second visit has lots of photos so goodness score is higher)*/\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_1=visit\", \"action_type_2=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\", \"confidence_1!=medium\", \"confidence_2!=high\"],\n                    \"labels\":[\"{place_1} visit and {action_2}\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions: visit + shopping (back to back) and visit with place 1 of medium confidence, shopping with place 2 of medium confidence (example: visit to place A + shopping, another visit to place B, the second visit has lots of photos so goodness score is higher)*/\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_1=visit\", \"action_type_2=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\", \"confidence_1!=medium\", \"confidence_2=high\"],\n                    \"labels\":[\"{place_1} visit and shopping at {place_2}\"],\n                },\n\n\n                {\n                    \"_comment_\": \"/* 2 actions: visit + shopping (back to back) and shopping with place 1 of medium confidence, visit with place 2 of medium/low confidence (example: visit to place A + shopping, another visit to place B, the first visit has lots of photos so goodness score is higher)*/\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_2=visit\", \"action_type_1=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\", \"place_count=2\",\"confidence_2=medium\", \"confidence_1!=high\"],\n                    \"labels\":[\"{action_1} and visit near {place_2}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions: visit + shopping (back to back) and shopping with place 1 of medium confidence, visit with place 2 of high confidence * (example: visit to place A + shopping, another visit to place B, the first visit has lots of photos so goodness score is higher) */\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_2=visit\", \"action_type_1=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\",\"confidence_2=medium\", \"confidence_1=high\"],\n                    \"labels\":[\"{action_1} at {place_1} and visit near {place_2}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions: visit + shopping (back to back) and shopping with place 1 of high/low confidence, visit with place 2 of medium/low confidence * (example: visit to place A + shopping, another visit to place B, the first visit has lots of photos so goodness score is higher) */\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_2=visit\", \"action_type_1=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\", \"confidence_2!=medium\", \"confidence_1!=high\"],\n                    \"labels\":[\"{action_1} and {place_2} visit|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions: visit + shopping (back to back) and shopping with place 1 of medium confidence, visit with place 2 of medium confidence * (example: visit to place A + shopping, another visit to place B, the first visit has lots of photos so goodness score is higher) */\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_2=visit\", \"action_type_1=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\", \"confidence_2!=medium\", \"confidence_1=high\"],\n                    \"labels\":[\"{action_1} at {place_1} and {place_2} visit|TitleCap\"],\n                },\n\n\n                {\n                    \"_comment_\": \"/* 2 actions: visit + dining (back to back) and visit with place 1 of medium confidence, dining with place 2 of medium/low confidence  (example: visit to place A + shopping, another visit to place B, the first visit has lots of photos so goodness score is higher)*/\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_1=visit\", \"action_type_2!=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\", \"place_count=2\",\"confidence_1=medium\", \"confidence_2!=high\"],\n                    \"labels\":[\"Visit near {place_1} and {action_2}\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions: visit + dining (back to back) and visit with place 1 of medium confidence, dining with place 2 of high confidence  (example: visit to place A + shopping, another visit to place B, the first visit has lots of photos so goodness score is higher) */\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_1=visit\", \"action_type_2!=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\",\"confidence_1=medium\", \"confidence_2=high\"],\n                    \"labels\":[\"Visit near {place_1} and eating at {place_2}\"],\n     