lace_2}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions: visit + dining (back to back) and dining with place 1 of medium confidence, visit with place 2 of high confidence   (example: visit to place A + shopping, another visit to place B, the first visit has lots of photos so goodness score is higher) */\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_2=visit\", \"action_type_1!=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\",\"confidence_2=medium\", \"confidence_1=high\"],\n                    \"labels\":[\"Eating at {place_1} and visit near {place_2}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions: visit + dining (back to back) and dining with place 1 of high/low confidence, visit with place 2 of medium/low confidence * (example: visit to place A + shopping, another visit to place B, the first visit has lots of photos so goodness score is higher) */\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_2=visit\", \"action_type_1!=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\", \"confidence_2!=medium\", \"confidence_1!=high\"],\n                    \"labels\":[\"{action_1} and {place_2} visit|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions: visit + dining (back to back) and dining with place 1 of medium confidence, visit with place 2 of medium confidence * (example: visit to place A + shopping, another visit to place B, the first visit has lots of photos so goodness score is higher)*/\",\n\n                    \"conditions\":[\"action_count = 2\", \"action_type_2=visit\", \"action_type_1!=shopping\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=2\", \"confidence_2!=medium\", \"confidence_1=high\"],\n                    \"labels\":[\"Eating at {place_1} and {place_2} visit|TitleCap\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 3+ actions and 2 action types: 2 visits + dining/shopping and visit is of highest bundle goodness score (example: visit to place A + shopping, another visit to place B, another visit to place C and the second visit has lots of photos so goodness score is highest)*/\",\n\n                    \"conditions\":[\"action_count >= 3\", \"unique_action_type_count=2\", \"unique_action_type_1=visit\", \"activity_count=0\", \"visit_count>1\"],\n                    \"labels\":[\"Visits to multiple places and {unique_action_2}\"],\n                },\n                {\n                    \"_comment_\": \"/* 3+ actions and 2 action types: 2 visits) + dining/shopping and dining/shoppinng is of highest bundle goodness socre (example: visit to place A + shopping, another visit to place B, another visit to place C and the first visit has lots of photos so goodness score is highest)*/\",\n\n                    \"conditions\":[\"action_count >= 3\", \"unique_action_type_count=2\",  \"unique_action_type_1!=visit\",\"activity_count=0\", \"visit_count>1\"],\n                    \"labels\":[\"{unique_action_1} and visits to multiple places|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* 3+ actions and 3 action types: visit + dining + shopping and visit is of highest bundle goodness score (example: visit to place A + shopping, another visit to place B + dining, another visit to place C and the last visit has lots of photos so goodness score is highest)*/*/\",\n\n                    \"conditions\":[\"action_count >= 3\", \"unique_action_type_count=3\", \"activity_count=0\", \"unique_action_type_1=visit\", \"visit_count=1\"],\n                    \"labels\":[\"{place_1} visit, {unique_action_2}, and {unique_action_3}\"],\n                },\n                {\n                    \"_comment_\": \"/* 3+ actions and 3 action types: visit + dining + shopping and shoppinng is of highest bundle goodness socre  (example: visit to place A + shopping, another visit to place B + dining, another visit to place C and the first visit has lots of photos so goodness score is highest)*/\",\n\n                    \"conditions\":[\"action_count >= 3\", \"unique_action_type_count=3\", \"activity_count=0\", \"unique_action_type_1!=visit\", \"unique_action_type_2=shopping\", \"visit_count=1\"],\n                    \"labels\":[\"Shopping and Eating out\"],\n                },\n                {\n                    \"_comment_\": \"/* 3+ actions and 3 action types: visit + dining + shopping and dining is of highest bundle goodness socre  (example: visit to place A + shopping, another visit to place B + dining, another visit to place C and the second visit has lots of photos so goodness score is highest)*/\",\n\n                    \"conditions\":[\"action_count >= 3\", \"unique_action_type_count=3\", \"activity_count=0\", \"unique_action_type_1!=visit\", \"unique_action_type_2!=shopping\", \"visit_count=1\"],\n                    \"labels\":[\"Eating out and Shopping\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 3+ actions and 3 action types: visit + dining + shopping  (example: visit to place A + shopping, another visit to place B + dining, another visit to place C, another visit to place D)*/\",\n\n                    \"conditions\":[\"action_count >= 3\", \"unique_action_type_count=3\", \"activity_count=0\", \"visit_count>1\"],\n                    \"labels\":[\"Shopping, eating out, and multiple visits\"],\n                },\n                {\n                    \"_comment_\": \"/* fall back for visit + shopping + dining*/\",\n\n                    \"conditions\":[\"unique_action_type_count>=2\", \"activity_count=0\", \"visit_count>=1\"],\n                    \"labels\":[\"Outing\"],\n                }\n            ]\n        }\n    ]\n}\n\n\n\n"
