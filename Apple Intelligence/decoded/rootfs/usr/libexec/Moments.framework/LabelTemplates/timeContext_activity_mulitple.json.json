"{\n    \"cases\": [\n        {\n            \"bundleType\":\"timeContext\",\n            \"templates\" :[\n                {\n                    \"_comment_\": \"/* 7 day workout summary */\",\n                    \"conditions\":[\"summary_type = workout_summary\"],\n                    \"labels\":[\"Recent Workouts\"],\n                },\n                {\n                    \"_comment_\": \"/* 2+ workout types - mind and body workout and other workout */\",\n\n                    \"conditions\":[\"unique_activity_count>1\", \"unique_action_type_count=1\",\"!summary_type\",\"unique_action_type_1=mind_and_body_workout\", \"unique_action_type_2=workout\"],\n                    \"labels\":[\"Mind and body workout and more\"],\n                },\n                {\n                    \"_comment_\": \"/* 2+ workout types - mind and body workout and other workout */\",\n\n                    \"conditions\":[\"unique_activity_count>1\", \"unique_action_type_count=1\",\"!summary_type\",\"unique_action_type_2=mind_and_body_workout\", \"unique_action_type_1=workout\"],\n                    \"labels\":[\"Mind and body workout and more\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 workout types and no place (back to back workouts) */\",\n\n                    \"conditions\":[\"unique_activity_count=2\", \"unique_action_type_count=1\", \"unique_place_count=0\",\"!summary_type\"],\n                    \"labels\":[\"{time} {unique_action_1} and {unique_action_2}\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 workout types and no place (back to back workouts) */\",\n\n                    \"conditions\":[\"unique_activity_count=2\", \"unique_action_type_count=1\", \"unique_place_count=0\",\"!summary_type\"],\n                    \"labels\":[\"{unique_action_1} and {unique_action_2}\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 2 workout types and workouts happen at single place of medium confidence without time */\",\n\n                    \"conditions\":[ \"unique_action_type_count=1\", \"unique_activity_count=2\", \"unique_place_count=1\", \"place_count=1\", \"confidence_1=medium\",\"!summary_type\"],\n                    \"labels\":[\"{time} {unique_action_1} and {unique_action_2} near {unique_place_1}\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 workout types and workouts happen at single place of medium confidence without time */\",\n\n                    \"conditions\":[ \"unique_action_type_count=1\", \"unique_activity_count=2\", \"unique_place_count=1\", \"place_count=1\", \"confidence_1=medium\",\"!summary_type\"],\n                    \"labels\":[\"{unique_action_1} and {unique_action_2} near {unique_place_1}\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 workout types and workouts happen at single place of high or low confidence without time*/\",\n\n                    \"conditions\":[ \"unique_action_type_count=1\", \"unique_activity_count=2\", \"unique_place_count=1\", \"place_count=1\",\"confidence_1!=medium\",\"!summary_type\"],\n                    \"labels\":[\"{time} {unique_action_1} and {unique_action_2}, {unique_place_1}\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 workout types and workouts happen at single place of high or low confidence without time*/\",\n\n                    \"conditions\":[ \"unique_action_type_count=1\", \"unique_activity_count=2\", \"unique_place_count=1\", \"place_count=1\",\"confidence_1!=medium\",\"!summary_type\"],\n                    \"labels\":[\"{unique_action_1} and {unique_action_2}, {unique_place_1}\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 2 workout types and not all workouts have place */\",\n\n                    \"conditions\":[\"unique_activity_count=2\", \"unique_action_type_count=1\", \"unique_place_count=1\", \"place_count>unique_place_count\",\"!summary_type\"],\n                    \"labels\":[\"{unique_action_1} and {unique_action_2}\"],\n                },\n                \n                {\n                    \"_comment_\": \"/* 2 workout types and 2+ places in the same city */\",\n\n                    \"conditions\":[\"unique_action_type_count=1\", \"unique_activity_count=2\", \"unique_place_count>1\", \"unique_city_count=1\"],\n                    \"labels\":[\"{unique_action_1} and {unique_action_2}, {unique_city_1}\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 2 workout types and 2+ places */\",\n\n                    \"conditions\":[\"unique_action_type_count=1\", \"unique_activity_count=2\", \"unique_place_count>1\",\"!summary_type\"],\n                    \"labels\":[\"{unique_action_1} and {unique_action_2}, multiple places\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 3+ workout types with no place */\",\n\n                    \"conditions\":[\"unique_action_type_count=1\", \"unique_activity_count>2\",\"unique_place_count=0\",\"!summary_type\"],\n                    \"labels\":[\"{time} {unique_action_1}, {unique_action_2} and more\"],\n                },\n                {\n                    \"_comment_\": \"/* 3+ workout types with no place */\",\n\n                    \"conditions\":[\"unique_action_type_count=1\", \"unique_activity_count>2\",\"unique_place_count=0\",\"!summary_type\"],\n                    \"labels\":[\"{unique_action_1}, {unique_action_2} and more\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 3+ workout types at single place of medium confidence */\",\n\n                    \"conditions\":[\"unique_action_type_count=1\", \"unique_activity_count>2\",\"unique_place_count=1\",\"place_count=1\", \"confidence_1=medium\",\"!summary_type\"],\n                    \"labels\":[\"{unique_action_1}, {unique_action_2}, and more, near {unique_place_1}\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 3+ workout types at single place of high or low confidence */\",\n\n                    \"conditions\":[\"unique_action_type_count=1\", \"unique_activity_count>2\",\"unique_place_count=1\",\"place_count=1\", \"confidence_1!=medium\",\"!summary_type\"],\n                    \"labels\":[\"{unique_action_1}, {unique_action_2}, and more, {unique_place_1}\"],\n                },\n                {\n                    \"_comment_\": \"/* 3+ workout types with more than 1 place in the same city */\",\n\n                    \"conditions\":[\"unique_action_type_count=1\", \"unique_activity_count>2\",\"unique_place_count>=1\",\"place_count>1\", \"unique_city_count=1\",\"!summary_type\"],\n                    \"labels\":[\"{unique_action_1}, {unique_action_2}, and more, {unique_city_1}\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 3+ workout types with more than 1 place */\",\n                    \"conditions\":[\"unique_action_type_count=1\", \"unique_activity_count>2\",\"unique_place_count>=1\",\"place_count>1\",\"!summary_type\"],\n                    \"labels\":[\"{unique_action_1}, {unique_action_2}, and more, multiple places\"],\n                },\n                {\n                    \"_comment_\": \"/* fallback for multiple workout */\",\n\n                    \"conditions\":[\"unique_activity_count>1\", \"unique_action_type_count=1\",\"!summary_type\"],\n                    \"labels\":[\"Workout\"],\n                }\n            ]\n        }\n    ]\n}\n\n\n\n"
