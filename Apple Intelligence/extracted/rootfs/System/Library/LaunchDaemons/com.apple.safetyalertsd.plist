<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.safetyalertsd</string>
	<key>LaunchEvents</key>
	<dict>
		<key>com.apple.bluetooth.discovery</key>
		<dict>
			<key>SafetyAlertsBLERelay</key>
			<dict>
				<key>xpcReportCompleteDevice</key>
				<true/>
				<key>discoveryFlags</key>
				<array>
					<string>ScreenOff</string>
				</array>
				<key>discoveryTypes</key>
				<array>
					<string>SafetyAlerts</string>
				</array>
				<key>bleScanRate</key>
				<string>Low</string>
				<key>bleScanRateScreenOff</key>
				<string>Background</string>
				<key>label</key>
				<string>SafetyAlertsBLERelay</string>
			</dict>
		</dict>
		<key>com.apple.CTTelephonyCenter</key>
		<dict>
			<key>kCTSMSCellBroadcastTelemetryNotification</key>
			<dict>
				<key>Name</key>
				<string>kCTSMSCellBroadcastTelemetryNotification</string>
			</dict>
			<key>kCTEventSMSMessageCellBroadcastStringGeofencingStarted</key>
			<dict>
				<key>Name</key>
				<string>kCTEventSMSMessageCellBroadcastStringGeofencingStarted</string>
			</dict>
			<key>kCTSMSCellBroadcastStringReceivedNotification</key>
			<dict>
				<key>Name</key>
				<string>kCTSMSCellBroadcastStringReceivedNotification</string>
			</dict>
		</dict>
		<key>com.apple.notifyd.matching</key>
		<dict>
			<key>kCTSMSCellBroadcastConfigChangedNotification</key>
			<dict>
				<key>Notification</key>
				<string>kCTSMSCellBroadcastConfigChangedNotification</string>
			</dict>
		</dict>
	</dict>
	<key>MachServices</key>
	<dict>
		<key>com.apple.private.alloy.safetyalerts-idswake</key>
		<true/>
		<key>com.apple.aps.safetyalerts</key>
		<true/>
		<key>com.apple.safetyalerts</key>
		<true/>
		<key>com.apple.usernotifications.delegate.com.apple.safetyalerts</key>
		<true/>
		<key>com.apple.usernotifications.delegate.com.apple.safetyalerts.aw</key>
		<true/>
		<key>com.apple.usernotifications.delegate.com.apple.safetyalerts.gen</key>
		<true/>
	</dict>
	<key>POSIXSpawnType</key>
	<string>Adaptive</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/safetyalertsd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>UserName</key>
	<string>mobile</string>
</dict>
</plist>
