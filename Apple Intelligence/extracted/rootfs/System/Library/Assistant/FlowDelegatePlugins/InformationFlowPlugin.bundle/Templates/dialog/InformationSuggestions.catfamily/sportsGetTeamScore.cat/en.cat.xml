<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<cat xmlns="urn:apple:names:siri:cat:1.0" locale="en">
  <phrases>
      <first phrase="suggestionUtterance">
          <!-- Try phrases using voc information. If voc information not available, fall back to phrases using team name string variables -->
          <text><var name="firstTeamVocLocation"/> <var name="firstTeamVocName"/> vs <var name="secondTeamVocLocation"/> <var name="secondTeamVocName"/> score</text>
          <text><var name="firstTeamFullName"/> vs <var name="secondTeamFullName"/> score</text>
          <text><var name="firstTeamVocLocation"/> <var name="firstTeamVocName"/> score</text>
          <text><var name="firstTeamFullName"/> score</text>
    </first>
  </phrases>
  <first>
    <dialog id="exampleUtterance"><phrase name="suggestionUtterance"/></dialog>
  </first>
</cat>
