<plist version="1.0">
<dict>
    <key>name</key>
    <string>com.apple.siri.ODDI.scorecard.hourly</string>
    <key>bundleIdentifier</key>
    <string>com.apple.siri.ODDIMetricsExtension</string>
    <key>taskRequest</key>
    <dict>
        <key>repeatingTask</key>
        <dict>
            <key>interval</key>
            <real>3600</real>
            <key>minDurationBetweenInstances</key>
            <integer>900</integer>
        </dict>
        <key>requiresProtectionClass</key>
        <string>ClassC</string>
        <key>priority</key>
        <string>Maintenance</string>
        <key>requiresUserInactivity</key>
        <true/>
        <key>requiresExternalPower</key>
        <true/>
        <key>groupName</key>
        <string>com.apple.siri.ODDI</string>
        <key>groupConcurrencyLimit</key>
        <integer>1</integer>
     </dict>
</dict>
</plist>
