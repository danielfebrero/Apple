"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?>\n<cat id=\"GetETA#GetEtaQuery\" locale=\"en\" xmlns=\"urn:apple:names:siri:cat:1.0\">\n    <conditions>\n        <condition name=\"isWalking\">\n          <expression name=\"transportationType\" op=\"eq\" value=\"'walking'\"/>\n        </condition>\n        <condition name=\"isDriving\">\n          <expression name=\"transportationType\" op=\"eq\" value=\"'driving'\"/>\n        </condition>\n        <condition name=\"isTransit\">\n          <expression name=\"transportationType\" op=\"eq\" value=\"'transit'\"/>\n        </condition>\n        <condition name=\"isCycling\">\n          <expression name=\"transportationType\" op=\"eq\" value=\"'cycling'\"/>\n        </condition>\n        <condition name=\"isTransportationUnspecified\">\n          <expression name=\"transportationType\" op=\"empty\" />\n        </condition>\n        \n        <condition name=\"isOriginSpecified\">\n          <expression name=\"origin\" op=\"nonempty\" />\n        </condition>\n        <condition name=\"isFromHere\">\n          <expression name=\"origin\" op=\"empty\" />\n        </condition>\n        \n        <condition name=\"walking\">\n          <and>\n            <sub-condition name=\"isWalking\"/>\n            <sub-condition name=\"isOriginSpecified\"/>\n          </and>\n        </condition>\n        \n        <condition name=\"driving\">\n          <and>\n            <sub-condition name=\"isDriving\"/>\n            <sub-condition name=\"isOriginSpecified\"/>\n          </and>\n        </condition>\n        \n        <condition name=\"transit\">\n          <and>\n            <sub-condition name=\"isTransit\"/>\n            <sub-condition name=\"isOriginSpecified\"/>\n          </and>\n        </condition>\n        \n        <condition name=\"cycling\">\n          <and>\n            <sub-condition name=\"isCycling\"/>\n            <sub-condition name=\"isOriginSpecified\"/>\n          </and>\n        </condition>\n        \n        <condition name=\"unspecifiedTransportation\">\n          <and>\n            <sub-condition name=\"isTransportationUnspecified\"/>\n            <sub-condition name=\"isOriginSpecified\"/>\n          </and>\n        </condition>\n        \n        <condition name=\"walkingFromHere\">\n          <and>\n            <sub-condition name=\"isWalking\"/>\n            <sub-condition name=\"isFromHere\"/>\n          </and>\n        </condition>\n        \n        <condition name=\"drivingFromHere\">\n          <and>\n            <sub-condition name=\"isDriving\"/>\n            <sub-condition name=\"isFromHere\"/>\n          </and>\n        </condition>\n        \n        <condition name=\"transitFromHere\">\n          <and>\n            <sub-condition name=\"isTransit\"/>\n            <sub-condition name=\"isFromHere\"/>\n          </and>\n        </condition>\n        \n        <condition name=\"cyclingFromHere\">\n          <and>\n            <sub-condition name=\"isCycling\"/>\n            <sub-condition name=\"isFromHere\"/>\n          </and>\n        </condition>\n        \n        <condition name=\"fromHere\">\n          <and>\n            <sub-condition name=\"isTransportationUnspecified\"/>\n            <sub-condition name=\"isFromHere\"/>\n          </and>\n        </condition>\n      </conditions>\n    \n    <first>\n        <dialog condition=\"walking\">How long does it take to get from <var name=\"origin\"/> to <var name=\"destination\"/> via walking?</dialog>\n        <dialog condition=\"driving\">How long does it take to get from <var name=\"origin\"/> to <var name=\"destination\"/> via driving?</dialog>\n        <dialog condition=\"transit\">How long does it take to get from <var name=\"origin\"/> to <var name=\"destination\"/> via transit?</dialog>\n        <dialog condition=\"cycling\">How long does it take to get from <var name=\"origin\"/> to <var name=\"destination\"/> via cycling?</dialog>\n        <dialog condition=\"unspecifiedTransportation\">How long does it take to get from <var name=\"origin\"/> to <var name=\"destination\"/>?</dialog>\n        \n        <dialog condition=\"walkingFromHere\">How long does it take to get from here to <var name=\"destination\"/> via walking?</dialog>\n        <dialog condition=\"drivingFromHere\">How long does it take to get from here to <var name=\"destination\"/> via driving?</dialog>\n        <dialog condition=\"transitFromHere\">How long does it take to get from here to <var name=\"destination\"/> via transit?</dialog>\n        <dialog condition=\"cyclingFromHere\">How long does it take to get from here to <var name=\"destination\"/> via cycling?</dialog>\n        <dialog condition=\"fromHere\">How long does it take to get from here to <var name=\"destination\"/>?</dialog>\n    </first>\n</cat>\n"
