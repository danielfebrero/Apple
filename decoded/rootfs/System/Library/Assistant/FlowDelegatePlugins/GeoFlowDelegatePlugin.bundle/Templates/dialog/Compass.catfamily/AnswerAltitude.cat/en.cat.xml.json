"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?>\n<cat xmlns=\"urn:apple:names:siri:cat:2.0\" id=\"Compass#AnswerAltitude\" locale=\"en\">\n    <first>\n        <dialog condition=\"positive\">You're about <var name=\"altitude\"/> above sea level.</dialog>\n        <dialog condition=\"negative\">You're about <var name=\"altitude\"/> below sea level.</dialog>\n        <dialog>You're at sea level.</dialog>\n    </first>\n    <conditions>\n        <condition name=\"positive\">\n            <expression name=\"altitude.value\" op=\"gt\" value=\"0\"/>\n        </condition>\n        <condition name=\"negative\">\n            <expression name=\"altitude.value\" op=\"lt\" value=\"0\"/>\n        </condition>\n    </conditions>\n</cat>\n"
