"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?>\n<cat xmlns=\"urn:apple:names:siri:cat:1.0\" locale=\"en\" id=\"CAMDisambiguate#AppShortcutCollisionFirstRunHomePod\">\n    <conditions>\n        <condition name=\"hasSecondPhrase\" note=\"True if secondPhrase exists\">\n            <expression name=\"secondPhrase\" op=\"nonempty\"/>\n        </condition>\n    </conditions>\n    <phrases>\n        <first phrase=\"displaySecondPhrase\">\n            <text condition=\"hasSecondPhrase\"> and \"<var name=\"secondPhrase\"/>\".</text>\n            <text>.</text>\n        </first>\n    </phrases>\n   <all>\n       <dialog>To do this, you need to turn on <var name=\"app\"/> shortcuts with Siri, which lets you say phrases like \"<var name=\"firstPhrase\"/>\"<phrase name=\"displaySecondPhrase\"/></dialog>\n       <dialog>Do you want to turn on <var name=\"app\"/> shortcuts now?</dialog>\n   </all>\n</cat>\n\n"
