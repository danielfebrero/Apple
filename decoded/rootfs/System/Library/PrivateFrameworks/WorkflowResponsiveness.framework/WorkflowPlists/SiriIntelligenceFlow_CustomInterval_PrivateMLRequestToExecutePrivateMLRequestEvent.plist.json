    },
    {
      "subsystem": "com.apple.privatemlclientInferenceProvider",
      "category": "provider",
      "name": "executePrivateMLRequest",
      "event_identifier_field_name": "requestIdentifier",
      "required_log_message_contents": [
        "waiting for tokens"
      ],
      "end": true
    }
