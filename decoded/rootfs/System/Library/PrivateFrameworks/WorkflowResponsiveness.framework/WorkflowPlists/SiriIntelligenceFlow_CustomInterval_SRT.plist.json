      "*"
    ],
    "com.apple.osanalytics.ReportCrash": [
      "performance"
    ],
    "com.apple.pommes": [
      "*"
    ],
    "com.apple.privatecloudcompute": [
      "*"
    ],
    "com.apple.privatemlclient": [
      "*"
    ],
    "com.apple.privatemlclientInferenceProvider": [
      "*"
    ],
    "com.apple.shortcuts": [
      "*"
    ],
    "com.apple.siri": [
      "Client",
