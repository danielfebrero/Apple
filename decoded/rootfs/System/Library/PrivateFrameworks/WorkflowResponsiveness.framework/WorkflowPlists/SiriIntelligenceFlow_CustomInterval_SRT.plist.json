{
  "name": "SiriIntelligenceFlow_CustomInterval_SRT",
  "contextual_telemetry": "YES",
  "maximum_duration": 30,
  "diagnostics": [
    {
      "trigger_threshold_duration_single": 7,
      "option_tailspin_includes_oslogs": true,
      "gather_tailspin": true,
      "option_report_omit_network_bound_intervals": true
    }
  ],
  "signposts": [
    {
      "subsystem": "com.apple.intelligenceflow",
      "category": "TurnManagerService",
      "name": "TurnInterval",
      "network_bound": "indeterminate",
      "incident_uuid_field_name": "ifUserTurnId",
      "early_allowance": 30
    },
    {
      "subsystem": "com.apple.intelligenceflow",
      "category": "WorkflowResponsiveness",
      "name": "GMSPlannerService.modelInference",
      "network_bound": "indeterminate",
      "diagnostics": [
        {
          "name": "TooManyModelInferences",
          "trigger_threshold_count": 5,
          "option_tailspin_includes_oslogs": true,
          "gather_tailspin": true
        }
      ]
    },
    {
      "subsystem": "com.apple.corespeech",
      "category": "Framework",
      "name": "UserSpeakingEnd",
      "start": true
    },
    {
      "subsystem": "com.apple.privatemlclientInferenceProvider",
      "category": "provider",
      "name": "requestOneShot",
      "network_bound": true,
      "required_log_message_contents": [
        "full request"
      ]
    },
    {
      "subsystem": "com.apple.privatemlclientInferenceProvider",
      "category": "provider",
      "name": "requestStream",
      "network_bound": true,
      "required_log_message_contents": [
        "full request"
      ]
    },
    {
      "subsystem": "com.apple.gms.PrototypeInferenceProvider",
      "category": "genAIModelProvider",
      "name": "completePrompt",
      "network_bound": true
    },
    {
      "subsystem": "com.apple.omnisearch",
      "category": "Search",
      "name": "OmniSearchService.agenticGlobalSearch",
      "network_bound": true
    },
    {
      "subsystem": "com.apple.siri",
      "category": "Client",
      "name": "UsefulUserFacingResults",
      "network_bound": "indeterminate",
      "end": true
    }
  ],
  "option_filter_tailspin_logs_to_subsystem_categories": {
    "com.apple.app_launch_measurement": [
      "*"
    ],
    "com.apple.appintents": [
      "*"
    ],
    "com.apple.CoreSceneUnderstanding": [
      "*"
    ],
    "com.apple.corespeech": [
      "*"
    ],
