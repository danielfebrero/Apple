{
  "artifact": {
    "entityInteractionHistogram": {
      "customAttributesTable": {
        "columns": [
          [
            "communicationMechanism",
            "INTEGER"
          ],
          [
            "bundleID",
            "TEXT"
          ]
        ],
        "tableName": "personInteractionMechanisms"
      },
      "entityInteractionEventsTableName": "personEntityInteractionEvents",
      "entityInteractionKeyTableName": "personEntityHistogramKeys",
      "query": {
        "attributeQueries": [
          {
            "communicationDirection": {
              "direction": "outgoing"
            }
          },
          {
            "interactionType": {
              "type": "communication"
            }
          },
          {
            "sessionEvent": {
              "event": "start"
            }
          }
        ],
        "entityClasses": [
          "person"
        ]
      },
      "tableName": "personEntityHistograms"
    },
    "path": "internal/views.db",
    "type": "entityInteractionHistogram"
  },
  "customViewClass": "EntityInteractionHistogramView",
  "featureFlag": "EntityRelevanceBiomeSources",
  "name": "personEntityHistograms",
  "type": "custom",
  "update": {
    "alwaysUpdateListeners": [
      {
        "computeIfPastSLA": false,
        "fullRebuildOnChange": true,
        "rebuildView": true,
        "schedule": "weekly"
      }
    ],
    "biomeListeners": [
      {
        "computeIfPastSLA": false,
        "requiredSource": false,
        "schedule": "every21Minutes",
        "stream": "Device.ScreenLocked"
      },
      {
        "computeIfPastSLA": false,
        "requiredSource": false,
        "schedule": "every21Minutes",
        "stream": "App.InFocus"
      },
      {
        "computeIfPastSLA": false,
        "requiredSource": false,
        "schedule": "every21Minutes",
        "stream": "App.Intent"
      }
    ],
    "group": "personEntityRelevance",
    "viewListeners": [
      {
        "name": "handleMap",
        "requiredSource": true,
        "schedule": "none"
      },
      {
        "name": "phPersonIdentifierMap",
        "requiredSource": true,
        "schedule": "none"
      }
    ]
  }
}
