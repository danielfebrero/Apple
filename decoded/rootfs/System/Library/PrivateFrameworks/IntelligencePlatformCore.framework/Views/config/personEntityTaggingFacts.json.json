{
  "artifact": {
    "path": "feature/features.db",
    "tableName": "kv",
    "type": "feature"
  },
  "featureConfig": {
    "signalConfig": {
      "personEntityTaggingFacts": {
        "photosPersonEntityHistogramsView": "photosPersonEntityHistograms"
      }
    }
  },
  "name": "personEntityTaggingFacts",
  "type": "signal",
  "update": {
    "alwaysUpdateListeners": [
      {
        "computeIfPastSLA": false,
        "schedule": "daily"
      }
    ],
    "knowledgeGraphListeners": [
      {
        "filters": [
          {
            "entityType": "SB104",
            "predicates": [
              "PS598/CS168/nm_unlocalizedRelationshipLabel"
            ],
            "sources": [
              "CNContact",
              "HKEmergencyContact"
            ]
          }
        ],
        "schedule": "live",
        "stores": [
          "stableGraph"
        ]
      }
    ]
  }
}
