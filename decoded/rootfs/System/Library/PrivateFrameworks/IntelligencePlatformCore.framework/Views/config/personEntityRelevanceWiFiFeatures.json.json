{
  "artifact": {
    "path": "feature/features.db",
    "type": "feature"
  },
  "featureConfig": {
    "signalConfig": {
      "entityRelevanceContextualFeatures": {
        "currentContextViews": [
          "currentWiFiContext"
        ],
        "entityInteractionHistogramView": "personEntityHistograms"
      }
    }
  },
  "name": "personEntityRelevanceWiFiFeatures",
  "type": "signal",
  "update": {
    "group": "personEntityRelevance",
    "viewListeners": [
      {
        "name": "personEntityHistograms",
        "schedule": "daily"
      },
      {
        "name": "currentWiFiContext",
        "schedule": "live"
      }
    ]
  }
}
