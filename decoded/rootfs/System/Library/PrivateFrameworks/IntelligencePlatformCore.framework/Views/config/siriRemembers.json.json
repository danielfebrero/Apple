{
  "artifact": {
    "diffType": "updatedObject",
    "path": "siri/remembers/view.db",
    "type": "siriRemembers",
    "updatedObject": {
      "diffTableMaxAge": 172800,
      "identifierColumn": "interactionIdentifier",
      "tableName": "diff",
      "updatedTimestampColumn": "updatedTimestamp"
    }
  },
  "clearOnError": false,
  "customViewClass": "SiriRemembers",
  "name": "siriRemembers",
  "supportsClientObservedErrorRecovery": true,
  "type": "custom",
  "update": {
