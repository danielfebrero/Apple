      {
        "highPriority": true,
        "rebuildOnPrune": false,
        "schedule": "live",
        "stream": "Siri.Remembers.MessageHistory"
      },
      {
        "highPriority": true,
        "rebuildOnPrune": false,
        "schedule": "live",
        "stream": "Siri.Remembers.CallHistory"
      },
      {
        "highPriority": true,
        "rebuildOnPrune": false,
        "schedule": "live",
        "stream": "Siri.Remembers.AssistantSuggestions"
      },
      {
        "highPriority": true,
        "rebuildOnPrune": false,
        "schedule": "live",
        "stream": "Siri.Remembers.AudioHistory"
      },
      {
        "computeIfPastSLA": false,
        "excludeLocal": true,
        "rebuildOnPrune": false,
        "schedule": "every7Minutes",
        "stream": "Siri.Remembers.InteractionHistory",
        "syncedDeviceTypes": [
