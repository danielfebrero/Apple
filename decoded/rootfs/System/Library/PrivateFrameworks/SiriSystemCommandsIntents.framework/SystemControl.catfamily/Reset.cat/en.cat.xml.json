"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?>\n<cat xmlns=\"urn:apple:names:siri:cat:4.0\" id=\"SystemControl#Reset\" locale=\"en\">\n  <first>\n    <all condition=\"deviceState.isRealityDevice\">\n      <dialog id=\"Item_Vision1\">You can do that in Transfer or Reset Apple Vision Pro settings.</dialog>\n      <dialog id=\"Item_Vision2\">To simply restart your Apple Vision Pro, just say ‘Restart my Apple Vision Pro'.</dialog>\n    </all>\n    <all condition=\"deviceState.isPhone\">\n      <dialog id=\"Item_Phone1\">You can do that in Transfer or Reset iPhone settings.</dialog>\n      <dialog id=\"Item_Phone2\">To simply restart your iPhone, just say ‘Restart my iPhone’.</dialog>\n    </all>\n    <all condition=\"deviceState.isPad\">\n      <dialog id=\"Item_Pad1\">You can do that in Transfer or Reset iPad settings.</dialog>\n      <dialog id=\"Item_Pad2\">To simply restart your iPad, just say ‘Restart my iPad’.</dialog>\n    </all>\n    <all condition=\"deviceState.isMac\">\n      <dialog id=\"Item_Mac1\">You can do that in Transfer or Reset settings.</dialog>\n      <dialog id=\"Item_Mac2\">To restart your Mac, choose ‘Restart…’ from the Apple menu.</dialog>\n    </all>\n    <all condition=\"deviceState.isAppleTV\">\n      <dialog id=\"Item_TV\">You can do that in Transfer settings.</dialog>\n    </all>\n    <all condition=\"deviceState.isWatch\">\n      <dialog id=\"Item_Watch\">You can do that in the Watch app on your iPhone.</dialog>\n    </all>\n    <dialog id=\"Item\">I'm sorry, I can't do that for you.</dialog>\n  </first>\n</cat>\n"
