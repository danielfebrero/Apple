        "ActivityGroupName": "com.apple.intelligenceplatform.IntelligencePlatformCore",
        "Priority": "Maintenance",
        "AllowBattery": false,
        "Repeating": true,
        "Interval": 604800,
        "CPUIntensive": true,
        "MaxConcurrencyLimit": 1,
        "PowerNap": true
      },
      "com.apple.intelligenceplatform.IntelligencePlatformCore.LongitudinalDataCollection": {
        "ActivityGroupName": "com.apple.intelligenceplatform.IntelligencePlatformCore",
        "Priority": "Maintenance",
        "AllowBattery": false,
        "Repeating": true,
        "Interval": 86400,
        "CPUIntensive": true,
        "MaxConcurrencyLimit": 1,
        "PowerNap": true
      },
      "com.apple.intelligenceplatform.IntelligencePlatformCore.AutonamingMetricsLogging": {
        "ActivityGroupName": "com.apple.intelligenceplatform.IntelligencePlatformCore",
        "Priority": "Maintenance",
        "AllowBattery": false,
        "Repeating": true,
        "Interval": 86400,
        "CPUIntensive": true,
