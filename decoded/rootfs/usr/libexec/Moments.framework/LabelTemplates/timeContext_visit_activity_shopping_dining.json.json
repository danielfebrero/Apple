"{\n    \"cases\": [\n        {\n            \"bundleType\":\"timeContext\",\n            \"templates\" :[\n\n                {\n                    \"_comment_\": \"/* 2 actions and 2 types: 1 workout + 1 dining/shopping and with 1 place*/\",\n                    \"conditions\":[\"action_count = 2\", \"unique_action_type_count=2\", \"activity_count=1\", \"visit_count=0\", \"unique_place_count=1\",\"!summary_type\"],\n                    \"labels\":[\"{unique_place_1}\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions and 2 types: 1 workout + 1 dining/shopping and with 2 places*/\",\n                    \"conditions\":[\"action_count = 2\", \"unique_action_type_count=2\", \"activity_count=1\", \"visit_count=0\", \"unique_place_count=2\",\"!summary_type\"],\n                    \"labels\":[\"{unique_place_1} and {unique_place_2}\"],\n                },\n                {\n                    \"_comment_\": \"/* 3+ actions and 3+ types: 1+ visit +  1+ workout + 1+ dining/shopping with 1 place*/\",\n                    \"conditions\":[\"action_count >= 3\", \"unique_action_type_count>=3\", \"unique_place_count=1\", \"activity_count>=1\", \"visit_count>=1\",\"!summary_type\"],\n                    \"labels\":[\"{unique_place_1}\"],\n                },\n                {\n                    \"_comment_\": \"/* 3+ actions and 3+ types: 1+ visit +  1+ workout + 1+ dining/shopping with 2 places */\",\n                    \"conditions\":[\"action_count >= 3\", \"unique_action_type_count>=3\", \"unique_place_count=2\", \"activity_count>=1\", \"visit_count>=1\",\"!summary_type\"],\n                    \"labels\":[\"{unique_place_1} and {unique_place_2}\"],\n                },\n                {\n                    \"_comment_\": \"/* 3+ actions and 3+ types: 1+ visit +  1+ workout + 1+ dining/shopping with 3+places*/\",\n                    \"conditions\":[\"action_count >= 3\", \"unique_action_type_count>=3\", \"unique_place_count>