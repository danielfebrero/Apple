"{\n    \"cases\": [\n        {\n            \"bundleType\":\"timeContext\",\n            \"templates\" :[\n                {\n                    \"_comment_\": \"/* dining/shopping with no place */\",\n                    \"conditions\":[\"action_count=1\", \"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\", \"unique_place_count=0\"],\n                    \"labels\":[\"{action}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* dining/shopping at a single place of low confidence*/\",\n                    \"conditions\":[\"action_count=1\", \"action_type=shopping\", \"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\", \"unique_place_count=1\", \"confidence=low\"],\n                    \"labels\":[\"Shopping, {place}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* dining/shopping at a single place of low confidence*/\",\n                    \"conditions\":[\"action_count=1\", \"action_type=eating_out\", \"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\", \"unique_place_count=1\", \"confidence=low\"],\n                    \"labels\":[\"Eating out, {place}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* shopping at a single place of medium confidence*/\",\n                    \"conditions\":[\"action_count = 1\", \"action_type=shopping\",\"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\", \"unique_place_count=1\", \"confidence=medium\"],\n                    \"labels\":[\"Shopping near {place}\"],\n                },\n                {\n                    \"_comment_\": \"/* eating at a single place of medium confidence*/\",\n                    \"conditions\":[\"action_count = 1\", \"action_type=eating_out\", \"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\", \"unique_place_count=1\", \"confidence=medium\"],\n                    \"labels\":[\"Eating out near {place}\"],\n                },\n                {\n                    \"_comment_\": \"/* eating at single place of high confidence*/\",\n                    \"conditions\":[\"action_count=1\", \"action_type=shopping\",\"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\", \"unique_place_count=1\", \"confidence=high\"],\n                    \"labels\":[\"Shopping at {place}\"],\n                },\n                {\n                    \"_comment_\": \"/* dining at single place of high confidence*/\",\n                    \"conditions\":[\"action_count=1\", \"action_type=eating_out\", \"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\", \"unique_place_count=1\", \"confidence=high\"],\n                    \"labels\":[\"Eating at {place}\"],\n                },\n\n                {\n                    \"_comment_\": \"/* back to back dining/shopping with 2 places of high confidence*/\",\n\n                    \"conditions\":[\"action_count=2\", \"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\", \"unique_place_count=2\", \"confidence_1=high\", \"confidence_2=high\"],\n                    \"labels\":[\"{action}, {unique_place_1} and {unique_place_2}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* back to back dining/shopping with 2 places in the same city which are not both high confidence */\",\n\n                    \"conditions\":[\"action_count=2\", \"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\", \"unique_place_count=2\",\"confidence_1!=high\", \"unique_city_count=1\"],\n                    \"labels\":[\"{action}, {unique_city_1}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* back to back dining/shopping with 2 places which are not both high confidence */\",\n\n                    \"conditions\":[\"action_count=2\", \"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\", \"unique_place_count=2\",\"confidence_1!=high\"],\n                    \"labels\":[\"{action}, multiple places|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* back to back dining/shopping with 2 places in the same city which are not both high confidence */\",\n\n                    \"conditions\":[\"action_count=2\", \"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\", \"unique_place_count=2\", \"confidence_2!=high\",\"unique_city_count=1\"],\n                    \"labels\":[\"{action}, {unique_city_1}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* back to back dining/shopping with 2 places which are not both high confidence */\",\n\n                    \"conditions\":[\"action_count=2\", \"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\", \"unique_place_count=2\", \"confidence_2!=high\"],\n                    \"labels\":[\"{action}, multiple places|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* back to back dining/shopping with 3+ places in the same city */\",\n\n                    \"conditions\":[\"action_count>2\", \"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\",  \"unique_place_count>2\", \"unique_city_count=1\"],\n                    \"labels\":[\"{action}, {unique_city_1}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* back to back dining/shopping with 3+ places */\",\n\n                    \"conditions\":[\"action_count>2\", \"visit_count=0\", \"unique_action_type_count=1\", \"activity_count=0\",  \"unique_place_count>2\"],\n                    \"labels\":[\"{action}, multiple places|TitleCap\"],\n                },\n\n\n                {\n                    \"_comment_\": \"/* 2 actions: dining + shopping at single place with low confidence*/\",\n\n                    \"conditions\":[\"action_count = 2\", \"visit_count=0\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=1\", \"confidence_1 = low\"],\n                    \"labels\":[\"{unique_action_1} and {unique_action_2}|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* 2 actions: dining + shopping at single place with medium confidence*/\",\n\n                    \"conditions\":[\"action_count = 2\", \"visit_count=0\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=1\", \"confidence_1 = medium\"],\n                    \"labels\":[\"{unique_action_1} and {unique_action_2} near {unique_place_1}|TitleCap\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 2 actions: dining + shopping at single place with high confidence*/\",\n\n                    \"conditions\":[\"action_count = 2\", \"visit_count=0\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count=1\", \"confidence_1 = high\"],\n                    \"labels\":[\"{unique_action_1} and {unique_action_2}, {unique_place_1}|TitleCap\"],\n                },\n                \n                {\n                    \"_comment_\": \"/* 2 actions: dining + shopping with more than one place in the same city */\",\n\n                    \"conditions\":[\"action_count = 2\",\"visit_count=0\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count>1\", \"unique_city_count=1\"],\n                    \"labels\":[\"{unique_action_1} and {unique_action_2}, {unique_city_1}|TitleCap\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 2 actions: dining + shopping with more than one place */\",\n\n                    \"conditions\":[\"action_count = 2\",\"visit_count=0\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count>1\"],\n                    \"labels\":[\"{unique_action_1} and {unique_action_2}, multiple places|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* 3+ actions but only two action type: dining + shopping with multiple places */\",\n\n                    \"conditions\":[\"action_count > 2\", \"visit_count=0\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count>1\", \"unique_city_count=1\"],\n                    \"labels\":[\"{unique_action_1}, {unique_action_2}, and more, {unique_city_1}|TitleCap\"],\n                },\n\n                {\n                    \"_comment_\": \"/* 3+ actions but only two action type: dining + shopping with multiple places */\",\n\n                    \"conditions\":[\"action_count > 2\", \"visit_count=0\", \"unique_action_type_count=2\", \"activity_count=0\", \"unique_place_count>1\"],\n                    \"labels\":[\"{unique_action_1}, {unique_action_2}, and more, multiple places|TitleCap\"],\n                },\n                {\n                    \"_comment_\": \"/* fall back for shopping + dining */\",\n\n                    \"conditions\":[\"visit_count=0\", \"unique_action_type_count=2\", \"activity_count=0\"],\n                    \"labels\":[\"Outing\"],\n                }\n            ]\n        }\n    ]\n}\n\n\n"
