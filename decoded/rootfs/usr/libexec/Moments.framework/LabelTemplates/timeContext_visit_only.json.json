"{\n    \"cases\": [\n        {\n            \"bundleType\":\"timeContext\",\n            \"templates\" :[\n                {\n                    \"_comment_\": \"/* visit with no place */\",\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count=0\"],\n                    \"labels\":[\"Outing\"],\n                },\n                {\n                    \"_comment_\": \"/* visit single place, medium confidence */\",\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count=1\", \"confidence_1=medium\"],\n                    \"labels\":[\"{time} visit near {unique_place_1}\"],\n                },\n                {\n                    \"_comment_\": \"/* visit single place, medium confidence */\",\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count=1\", \"confidence_1=medium\"],\n                    \"labels\":[\"Near {unique_place_1}\"],\n                },\n\n                {\n                    \"_comment_\": \"/* visit single place , high confidence or low confidence*/\",\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count=1\", \"confidence_1!=medium\"],\n                    \"labels\":[\"{time} visit to {unique_place_1}\"],\n                },\n                {\n                    \"_comment_\": \"/* visit single place, high confidence or low confidence*/\",\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count=1\", \"confidence_1!=medium\"],\n                    \"labels\":[\"{unique_place_1}\"],\n                },\n\n\n                {\n                    \"_comment_\": \"/* visit 2 places and both are medium confidence*/\",\n\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count=2\", \"con