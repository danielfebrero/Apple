bels\":[\"Near {unique_place_1} and {unique_place_2}\"],\n                },\n                {\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count=2\", \"confidence_1!=medium\", \"confidence_2=medium\", \"include_low_confidence_place_name\"],\n                    \"labels\":[\"{time} visit to {unique_place_1} and a nearby place\"],\n                },\n                {\n                    \"_comment_\": \"/* visit 2 places, place 2 is medium confidence and place 1 is high/low confidence */\",\n\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count=2\", \"confidence_1!=medium\", \"confidence_2=medium\"],\n                    \"labels\":[\"{time} visit near {unique_place_1} and {unique_place_2}\"],\n                },\n                {\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count=2\", \"confidence_1!=medium\", \"confidence_2=medium\", \"include_low_confidence_place_name\"],\n                    \"labels\":[\"Near {unique_place_1} and a nearby place\"],\n                },\n                {\n                    \"_comment_\": \"/* visit 2 places, place 2 is medium confidence and place 1 is high/low confidence */\",\n\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count=2\", \"confidence_1!=medium\", \"confidence_2=medium\"],\n                    \"labels\":[\"Near {unique_place_1} and {unique_place_2}\"],\n                },\n                \n                {\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count=2\", \"confidence_1!=medium\", \"confidence_2!=medium\", \"include_low_confidence_place_name\"],\n                    \"labels\":[\"{time} visit to {unique_place_1} and a nearby place\"],\n                },\n                {\n               