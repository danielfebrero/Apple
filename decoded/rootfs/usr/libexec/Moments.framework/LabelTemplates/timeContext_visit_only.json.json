idence */\",\n\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count>2\",\"confidence_1=medium\"],\n                    \"labels\":[\"{time} visit near {unique_place_1}\"],\n                },\n                {\n                    \"_comment_\": \"/* visit 3+ places, place 1 is medium confidenc */\",\n\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\", \"unique_place_count>2\",\"confidence_1=medium\"],\n                    \"labels\":[\"Near {unique_place_1}\"],\n                },\n                {\n                    \"_comment_\": \"/* fall back for visit_only cases */\",\n\n                    \"conditions\":[\"action_type_1=visit\", \"unique_action_type_count=1\"],\n                    \"labels\":[\"Outing\"],\n                }\n            ]\n        }\n    ]\n}\n\n\n"
