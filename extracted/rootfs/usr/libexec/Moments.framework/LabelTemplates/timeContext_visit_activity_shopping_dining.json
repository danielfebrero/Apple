{
    "cases": [
        {
            "bundleType":"timeContext",
            "templates" :[

                {
                    "_comment_": "/* 2 actions and 2 types: 1 workout + 1 dining/shopping and with 1 place*/",
                    "conditions":["action_count = 2", "unique_action_type_count=2", "activity_count=1", "visit_count=0", "unique_place_count=1","!summary_type"],
                    "labels":["{unique_place_1}"],
                },
                {
                    "_comment_": "/* 2 actions and 2 types: 1 workout + 1 dining/shopping and with 2 places*/",
                    "conditions":["action_count = 2", "unique_action_type_count=2", "activity_count=1", "visit_count=0", "unique_place_count=2","!summary_type"],
                    "labels":["{unique_place_1} and {unique_place_2}"],
                },
                {
                    "_comment_": "/* 3+ actions and 3+ types: 1+ visit +  1+ workout + 1+ dining/shopping with 1 place*/",
                    "conditions":["action_count >= 3", "unique_action_type_count>=3", "unique_place_count=1", "activity_count>=1", "visit_count>=1","!summary_type"],
                    "labels":["{unique_place_1}"],
                },
                {
                    "_comment_": "/* 3+ actions and 3+ types: 1+ visit +  1+ workout + 1+ dining/shopping with 2 places */",
                    "conditions":["action_count >= 3", "unique_action_type_count>=3", "unique_place_count=2", "activity_count>=1", "visit_count>=1","!summary_type"],
                    "labels":["{unique_place_1} and {unique_place_2}"],
                },
                {
                    "_comment_": "/* 3+ actions and 3+ types: 1+ visit +  1+ workout + 1+ dining/shopping with 3+places*/",
                    "conditions":["action_count >= 3", "unique_action_type_count>=3", "unique_place_count>2", "activity_count>=1", "visit_count>=1","!summary_type"],
                    "labels":["{unique_place_1} and nearby places"],
                },
                {
                    "_comment_": "/* fall back for visit + activity + shopping + dining*/",
                    "conditions":["unique_action_type_count>=3", "activity_count>=1", "visit_count>=1","!summary_type"],
                    "labels":["Outing"],
                },
                {
                    "_comment_": "/* fall back for  activity + shopping + dining*/",
                    "conditions":["unique_action_type_count>=3", "activity_count>=1", "visit_count=0", "!summary_type"],
                    "labels":["Workout"],
                }

            ]
        }
    ]
}



